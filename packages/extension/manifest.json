{
  "manifest_version": 3,
  "name": "Playwright · ZNZRYB No Focus",
  "version": "0.4.0.2",
  "description": "ZNZRYB 本地修改版：配合本地 MCP 的后台模式，减少扩展自动化抢夺焦点。",
  "permissions": [
    "debugger",
    "activeTab",
    "tabs",
    "tabGroups",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "lib/background.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "Playwright · ZNZRYB No Focus",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "key": "",
  "version_name": "0.4.0-znzryb.2",
  "minimum_chrome_version": "120"
}
